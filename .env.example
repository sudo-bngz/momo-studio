# Copy to .env.local. Next.js and the setup scripts read it; never commit it.

# ---- The app (server side only) ----

# Where GoHead runs, as the app's server reaches it (no /api suffix).
GOHEAD_URL=http://localhost:8080

# The studio's time zone: bookings are typed and shown in it.
STUDIO_TIMEZONE=Europe/Paris

# Currency of prices and gear values.
STUDIO_CURRENCY=EUR

# ---- The setup scripts only (npm run gohead:*) ----

# A GoHead admin account. docker-compose.yml creates this one on first start.
# Don't set them where the app is deployed: people sign in with their own
# GoHead account.
GOHEAD_USERNAME=admin
GOHEAD_PASSWORD=gohead-local-password
