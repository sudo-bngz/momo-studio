{
  "name": "studio-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Back-office for an electronic music studio on GoHead: gear inventory, cable plan, bookings.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "gohead:push": "gohead-client model push gohead/model.json",
    "gohead:seed": "gohead-client seed gohead/seed.json",
    "gohead:types": "gohead-client types --model gohead/model.json --out src/gohead.d.ts",
    "gohead:access": "node scripts/setup-access.mjs",
    "gohead:setup": "npm run gohead:push && npm run gohead:types && npm run gohead:access",
    "docs": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/build-docs.mjs",
    "studio:bootstrap": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/bootstrap-studio.mjs"
  },
  "dependencies": {
    "@gohead-cms/client": "^0.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
